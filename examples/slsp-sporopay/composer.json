{
    "name": "tomaj/payment-simulator-example-slsp-sporopay",
    "description": "payment-simulator example: slsp-sporopay",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "tomaj/omnipay-slsp": "dev-master",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tomaj/omnipay-slsp.git",
            "no-api": true
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
