root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,js,css,xml,json,json5}]
indent_size = 2

[composer.json]
indent_style = tab

# Nette configuration and Latte templates use tabs
[*.{neon,latte}]
indent_style = tab

[*.md]
indent_style = unset
trim_trailing_whitespace = false
