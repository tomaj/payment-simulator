{
	"name": "tomaj/payment-simulator",
	"description": "Simulator of Slovak bank online payment gateways (TatraPay, CardPay, ComfortPay, VUB ePlatby, SporoPay)",
	"license": "MIT",
	"type": "project",
	"keywords": [
		"payment",
		"simulator",
		"sandbox",
		"tatrapay",
		"cardpay",
		"comfortpay",
		"eplatby",
		"sporopay",
		"omnipay",
		"slovakia"
	],
	"authors": [
		{
			"name": "Tomas Majer",
			"email": "tomasmajer@gmail.com",
			"homepage": "http://www.tomaj.sk/"
		}
	],
	"homepage": "https://platby.tomaj.sk/",
	"support": {
		"issues": "https://github.com/tomaj/payment-simulator/issues",
		"source": "https://github.com/tomaj/payment-simulator",
		"docs": "https://tomaj.github.io/payment-simulator/",
		"security": "https://github.com/tomaj/payment-simulator/security/policy"
	},
	"require": {
		"php": "^8.4",
		"ext-openssl": "*",
		"latte/latte": "^3.0",
		"moneyphp/money": "^4.9.0",
		"nette/application": "^3.2",
		"nette/bootstrap": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/robot-loader": "^4.0",
		"nette/security": "^3.2",
		"nette/utils": "^4.0",
		"php-http/guzzle7-adapter": "^1.0",
		"tomaj/omnipay-slsp": "dev-master",
		"tomaj/omnipay-tatra": "dev-master",
		"tomaj/omnipay-vub": "dev-master",
		"tracy/tracy": "^2.10"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.3",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0.5",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^13.2",
		"rector/rector": "^2.8"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/tomaj/omnipay-vub.git",
			"no-api": true
		}
	],
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests"
		}
	},
	"config": {
		"platform": {
			"php": "8.4.1"
		},
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": false
		}
	},
	"scripts": {
		"check": [
			"@phpcs",
			"@phpstan",
			"@rector",
			"@test"
		],
		"coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
		],
		"cs-fix": "php-cs-fixer fix",
		"lint": "find app www -name '*.php' -print0 | xargs -0 -n1 php -l",
		"phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpunit": [
			"@putenv XDEBUG_MODE=off",
			"phpunit --no-coverage"
		],
		"rector": "rector --dry-run",
		"rector-fix": "rector",
		"test": "@phpunit"
	},
	"scripts-descriptions": {
		"check": "Run code style, static analysis, Rector and tests",
		"coverage": "Run the tests with Clover and HTML coverage reports in build/",
		"cs-fix": "Fix the code style with PHP-CS-Fixer",
		"lint": "Check that every PHP file in app/ and www/ compiles",
		"phpcs": "Check the code style with PHP-CS-Fixer (dry run)",
		"phpstan": "Run PHPStan static analysis",
		"phpunit": "Run the PHPUnit tests without coverage",
		"rector": "Show the changes Rector would make (dry run)",
		"rector-fix": "Apply the Rector changes",
		"test": "Run the test suite"
	}
}
