{
	"name": "tomaj/payment-simulator",
	"description": "Simulator of Slovak bank online payment gateways (TatraPay, CardPay, ComfortPay, VUB ePlatby, SporoPay)",
	"license": "MIT",
	"type": "project",
	"keywords": [
		"payment",
		"simulator",
		"sandbox",
		"tatrapay",
		"cardpay",
		"comfortpay",
		"eplatby",
		"sporopay",
		"omnipay",
		"slovakia"
	],
	"authors": [
		{
			"name": "Tomas Majer",
			"email": "tomasmajer@gmail.com",
			"homepage": "http://www.tomaj.sk/"
		}
	],
	"homepage": "https://platby.tomaj.sk/",
	"support": {
		"issues": "https://github.com/tomaj/payment-simulator/issues",
		"source": "https://github.com/tomaj/payment-simulator",
		"docs": "https://github.com/tomaj/payment-simulator#readme",
		"security": "https://github.com/tomaj/payment-simulator/security/policy"
	},
	"require": {
		"php": "^8.3",
		"ext-openssl": "*",
		"latte/latte": "^3.0",
		"moneyphp/money": "^3.3.3",
		"nette/application": "^3.2",
		"nette/bootstrap": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/robot-loader": "^4.0",
		"nette/security": "^3.2",
		"nette/utils": "^4.0",
		"php-http/guzzle7-adapter": "^1.0",
		"tomaj/omnipay-slsp": "^3.0",
		"tomaj/omnipay-tatra": "^4.0",
		"tomaj/omnipay-vub": "^3.0",
		"tracy/tracy": "^2.10"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.75",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0"
	},
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": false
		}
	},
	"scripts": {
		"check": [
			"@phpcs",
			"@phpstan",
			"@lint"
		],
		"cs-fix": "php-cs-fixer fix",
		"lint": "find app www -name '*.php' -print0 | xargs -0 -n1 php -l",
		"phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
		"phpstan": "phpstan analyse --memory-limit=1G"
	}
}
